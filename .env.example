# Local development defaults. Change these before any public deployment.
POSTGRES_USER=uber
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092

GATEWAY_HTTP_PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

DATABASE_URL=
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:19092

# Generate a random secret with at least 32 characters before starting auth.
JWT_SECRET=

# Local browser URL; use HTTPS and COOKIE_SECURE=true when deployed.
APP_URL=http://localhost:8080
COOKIE_SECURE=false
# Mailpit captures local development mail at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Uber Clone <no-reply@example.test>
SMTP_USER=
SMTP_PASSWORD=
# Google OAuth credentials belong here only in your ignored .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
